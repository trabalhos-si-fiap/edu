# Variáveis obrigatórias (sem default em app/config.py) — Settings() estoura
# no import se alguma faltar. Valores aqui são exemplos, nunca segredos reais.
JWT_SECRET=change-me-to-a-long-random-secret

# Banco próprio do serviço (fase 2, módulo support).
DATABASE_URL=postgresql+asyncpg://edu:edu@localhost:5433/chatbot_db

# Opcionais — já têm default em app/config.py, listadas aqui só para
# documentar o que existe.
# JWT_ALGORITHM=HS256
# GROQ_API_KEY=
# LEARNING_SERVICE_URL=http://learning-service:8000

# Opcional — já tem default em app/config.py.
# DATABASE_URL_TEST=postgresql+asyncpg://edu:edu@localhost:5433/chatbot_test
