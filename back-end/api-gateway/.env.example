# O gateway não tem variável obrigatória: toda Settings de app/config.py tem
# default. Este arquivo documenta o que existe e o que muda em produção.
# Valores aqui são exemplos, nunca segredos reais.

# Origens liberadas para CORS (lista JSON). Curinga é proibido —
# allow_credentials=True com "*" é rejeitado pelo browser e vazaria a API.
CORS_ORIGINS=["http://localhost:3000"]

# URLs internas (rede Docker). A porta é sempre 8000, que é a que cada serviço
# expõe DENTRO do container; o mapeamento 8101:8000 etc. do docker-compose.yml
# só vale para acesso de fora do Docker.
# AUTH_SERVICE_URL=http://auth-users-service:8000
# LEARNING_SERVICE_URL=http://learning-service:8000
# COMMERCE_SERVICE_URL=http://commerce-service:8000
# NOTIFICATION_SERVICE_URL=http://notification-service:8000
# ANALYTICS_SERVICE_URL=http://analytics-service:8000
# CHATBOT_SERVICE_URL=http://chatbot-service:8000

# Timeout de cada chamada repassada a um serviço.
# REQUEST_TIMEOUT_SECONDS=30.0
