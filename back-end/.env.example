COMPOSE_PROJECT_NAME=edu

ENV=development
DEBUG=true

POSTGRES_USER=edu
POSTGRES_PASSWORD=edu
POSTGRES_DB=edu
DATABASE_URL=postgresql+asyncpg://edu:edu@postgres:5432/edu
DATABASE_URL_TEST=postgresql+asyncpg://edu:edu@postgres:5432/edu_test

REDIS_PASSWORD=edu
REDIS_URL=redis://:edu@redis:6379/0
REDIS_URL_TEST=redis://:edu@redis:6379/15

RABBITMQ_USER=edu
RABBITMQ_PASSWORD=edu
CELERY_BROKER_URL=amqp://edu:edu@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://:edu@redis:6379/1

SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# ── Object storage (imagens de produto) ───────────────────────────────────
# A API fala o protocolo S3 via aioboto3. R2 (Cloudflare) em prod, MinIO em dev.
# Deixe as linhas abaixo COMENTADAS para usar o MinIO do docker-compose: os
# defaults do código já apontam para ele (http://minio:9000, bucket edu-media,
# credenciais edu/edu-secret). Descomente e preencha com os valores reais do R2
# apenas se quiser que o dev use o bucket de produção (não recomendado).
# R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<sua-access-key>
# R2_SECRET_ACCESS_KEY=<sua-secret-key>
# R2_BUCKET=<seu-bucket>
# R2_REGION=auto
# Endpoint usado para montar a presigned URL acessível pelo app/device.
# Em dev você NÃO precisa setar isto: `make back-up` deriva o host da LAN
# automaticamente (mesmo HOST_IP do `make front`) e injeta via docker-compose,
# então as imagens carregam no emulador, no simulador e em devices físicos.
# Em prod, defina explicitamente (normalmente o mesmo host do R2_ENDPOINT_URL).
# R2_PUBLIC_ENDPOINT_URL=http://10.0.2.2:9000

# ── E-mail provider for password reset ───────────────────────────────────────
# "console" (default) only logs the email to stdout — safe for local dev.
# "resend" sends via the Resend API. Get a key at https://resend.com.
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM="Edu <no-reply@edu.app>"

# ── Portas host ───────────────────────────────────────────────────────────
# Portas publicadas na máquina. As internas dos containers não mudam (8000).
# O Flutter fala com o legacy em API_PORT_EXTERNAL — mexer aqui muda o app.
POSTGRES_PORT_EXTERNAL=5433
REDIS_PORT_EXTERNAL=6380
RABBITMQ_PORT_EXTERNAL=5673
RABBITMQ_UI_PORT_EXTERNAL=15673
API_PORT_EXTERNAL=8001

# ── Microserviços ─────────────────────────────────────────────────────────
# Mesmo segredo em todos os serviços novos: cada um valida o JWT sozinho.
# Obrigatório — o docker-compose.yml usa ${JWT_SECRET:?...} e falha sem ele.
# JWT_ALGORITHM já está declarado acima, compartilhado com o legacy.
JWT_SECRET=troque_por_uma_chave_secreta_grande

EXCHANGE_NAME=edu.events

# Origens liberadas no gateway (lista JSON — curinga é proibido).
CORS_ORIGINS=["http://localhost:3000"]

# Porta host do gateway. Os seis serviços ficam em 8101-8106, fixos no compose.
# A faixa 80xx é do legacy (API_PORT_EXTERNAL) e de outros projetos da máquina.
GATEWAY_PORT_EXTERNAL=8100

# ── APIs externas ─────────────────────────────────────────────────────────
# Sem GROQ_API_KEY, learning/chatbot/analytics caem no fallback por template.
GROQ_API_KEY=

# Chave do Google Maps. O nome canônico é este, herdado do legacy; o
# docker-compose.yml a repassa ao commerce-service como GOOGLE_MAPS_API_KEY,
# que é o nome que a config dele lê. Não duplique a chave sob os dois nomes.
GOOGLE_MAPS_API_PLATAFORM=

# Nota: RABBITMQ_URL não fica aqui. Dentro do compose ela é montada por
# interpolação a partir de RABBITMQ_USER/RABBITMQ_PASSWORD apontando para o
# host `rabbitmq`; para rodar um serviço direto no host, use o `.env` do
# próprio serviço, que aponta para localhost:5673.
