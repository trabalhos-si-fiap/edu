# Variáveis obrigatórias (sem default em app/config.py) — Settings() estoura
# no import se alguma faltar. Valores aqui são exemplos, nunca segredos reais.
DATABASE_URL=postgresql+asyncpg://edu:edu@localhost:5433/commerce_db
RABBITMQ_URL=amqp://edu:edu@localhost:5673/
JWT_SECRET=change-me-to-a-long-random-secret

# Opcionais — já têm default em app/config.py, listadas aqui só para
# documentar o que existe.
# DATABASE_URL_TEST=postgresql+asyncpg://edu:edu@localhost:5433/commerce_test
# EXCHANGE_NAME=edu.events
# JWT_ALGORITHM=HS256
# GOOGLE_MAPS_API_KEY=
# REDIS_URL=redis://:edu@redis:6379/0
# REDIS_URL_TEST=redis://:edu@redis:6379/14
# R2_ENDPOINT_URL=http://minio:9000
# R2_ACCESS_KEY_ID=edu
# R2_SECRET_ACCESS_KEY=edu-secret
# R2_BUCKET=edu-media

# Rede de segurança da apresentação. AUSENTE = DESLIGADO, que é o padrão e o
# que a spec C pede. Se ligar, use um prazo BEM maior que três minutos — dez
# minutos é o valor sugerido:
# AVANCO_AUTOMATICO_SEGUNDOS=600
# SIMULADOR_POSICAO_SEGUNDOS=10
